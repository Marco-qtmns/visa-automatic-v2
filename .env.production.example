# D1 development/staging placeholders only. Never commit the populated copy.
DATA_ROOT=/srv/application-data
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

POSTGRES_DB=application_staging
POSTGRES_USER=application_runtime
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://application_runtime:replace-with-url-encoded-password@postgres:5432/application_staging

# Use the exact private origin. For Tailscale Serve, use the tailnet HTTPS URL.
CORS_ORIGINS=https://visa-pi.example-tailnet.ts.net
MFA_ENCRYPTION_KEY=cmVwbGFjZS13aXRoLWdlbmVyYXRlZC1rZXktMDAwMDA=
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=true

MAX_UPLOAD_SIZE_MB=20
MAX_GENERATED_ARTIFACT_MB=30
MAX_CONVERSATION_IMPORT_MB=2

# External AI remains disabled for D1.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
QUALITY_PROVIDER=manual_only
FACT_EXTRACTION_PROVIDER=disabled
